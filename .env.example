# Market Almanac configuration. Copy to `.env` and fill in what you need.
# `.env` is git-ignored; never commit real credentials.

# --- Mode -------------------------------------------------------------------
# demo: offline, synthetic data for the fictional "Demoland" (no credentials needed)
# live: real data from HDX HAPI, NASA POWER, World Bank, IMF and FAOSTAT
MARKET_ALMANAC_MODE=demo
APP_ENV=development
LOG_LEVEL=INFO

# --- Storage ----------------------------------------------------------------
# PostgreSQL is recommended (postgres://, postgresql:// and postgresql+psycopg:// are accepted).
# The default SQLite file needs no setup and is fine for the demo.
DATABASE_URL=sqlite:///./data/market-almanac.db
# DATABASE_URL=postgresql://market_almanac:market_almanac@localhost:5432/market_almanac
DATA_DIR=./data
CACHE_DIR=./data/cache

# --- API --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (GET only).
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_PAGE_SIZE=1000

# --- Web --------------------------------------------------------------------
# Public URL of the API as seen by the browser. Contains no secrets.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional MapLibre style URL for the explorer map (defaults to OpenFreeMap "positron").
# NEXT_PUBLIC_MAP_STYLE_URL=

# --- Provider credentials (live mode) -----------------------------------------
# HDX HAPI requires an app identifier: base64 of "<application name>:<email>".
# Generate one at https://hapi.humdata.org/docs (the "generate app identifier" endpoint).
# Required for live price ingestion. Never logged, never sent to the browser.
HDX_HAPI_APP_IDENTIFIER=

# FAOSTAT API: either a bearer token (expires) or a username/password to obtain one.
# Optional: without them, `market-almanac ingest --source agriculture --bulk` uses the public bulk file.
FAOSTAT_ACCESS_TOKEN=
FAOSTAT_USERNAME=
FAOSTAT_PASSWORD=

# NASA POWER, World Bank and IMF need no credentials.

# --- HTTP behaviour -----------------------------------------------------------
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_SECONDS=1.0
HTTP_MAX_CONCURRENCY=4
HTTP_CACHE_TTL_HOURS=24
